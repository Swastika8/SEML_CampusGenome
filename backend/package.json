{
  "name": "campus-genome-backend",
  "version": "1.0.0",
  "description": "RESTful Backend API and PostgreSQL Database for CampusGenome",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/initDb.js",
    "db:seed": "node src/db/seedDb.js",
    "demo": "node --watch src/server.js --demo",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  }
}
