# Local demo: npm run dev at the repository root needs no .env file.
# Standard PostgreSQL server: copy this file to backend/.env and configure below.
PORT=5000
NODE_ENV=development
DB_MODE=postgres
# HOST=127.0.0.1
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace_with_your_database_password
PGDATABASE=CampusGenome
# Alternatively use DATABASE_URL=postgresql://user:password@host:5432/CampusGenome

# Production requires a unique random secret of at least 32 characters.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default requests per IP per minute; auth also has a separate limit.
API_RATE_LIMIT=300
# Direct/local API: 0. Set the verified proxy hop count for your hosting topology.
# The deployment guide uses 1 for a direct Render web-service URL.
TRUST_PROXY_HOPS=0
